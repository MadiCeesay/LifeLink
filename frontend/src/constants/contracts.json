        "type": "string",
        "minLength": 3,
        "maxLength": 1000
      }
    },
    "required": ["status", "reason"],
    "additionalProperties": false
  },
  "Verification": {
    "type": "object",
    "properties": {
      "verificationStatus": {
        "type": "string",
        "enum": [
          "UNVERIFIED",
          "VERIFIED",
          "SUSPENDED",
          "REQUIRES_REVERIFICATION"
        ]
      },
      "verifiedBloodType": {
        "type": "string",
        "enum": ["A+", "A-", "B+", "B-", "AB+", "AB-", "O+", "O-", null],
        "nullable": true
      },
      "verifiedAt": {
        "type": "string",
        "format": "date-time",
        "nullable": true
      },
      "verifiedByFacility": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{24}$",
            "example": "0123456789abcdef01234567"
          },
          "name": {
            "type": "string"
          },
          "facilityType": {
            "type": "string",
            "enum": [
              "HOSPITAL",
              "BLOOD_BANK",
              "HEALTH_CENTRE",
              "CLINIC",
              "OTHER"
            ]
          }
        },
        "required": ["id", "name", "facilityType"],
        "additionalProperties": false,
        "nullable": true
      }
    },
    "required": [
      "verificationStatus",
      "verifiedBloodType",
      "verifiedAt",
      "verifiedByFacility"
    ],
    "additionalProperties": false
  },
  "DonorLookup": {
