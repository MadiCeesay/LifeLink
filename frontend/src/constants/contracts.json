{
  "Error": {
    "type": "object",
    "properties": {
      "success": {
        "type": "boolean",
        "enum": [false]
      },
      "error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "details": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              },
              "required": ["field", "message"],
              "additionalProperties": false
            }
          }
        },
        "required": ["code", "message"],
        "additionalProperties": false
      }
    },
    "required": ["success", "error"],
    "additionalProperties": false
  },
  "GeoPoint": {
    "type": "object",
    "properties": {
      "type": {
        "type": "string",
        "enum": ["Point"]
      },
      "coordinates": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "description": "Exactly [longitude, latitude]: longitude -180..180; latitude -90..90. Both finite JSON numbers. Backend enforces position-specific bounds.",
        "example": [-16.6, 13.4]
      }
    },
    "required": ["type", "coordinates"],
    "additionalProperties": false
  },
  "Registration": {
    "type": "object",
    "properties": {
      "name": {
        "type": "string",
        "minLength": 2,
        "maxLength": 100
      },
      "email": {
        "type": "string",
        "format": "email",
        "maxLength": 254,
        "example": "example@example.invalid"
      },
      "phone": {
        "type": "string",
        "minLength": 7,
        "maxLength": 30,
        "pattern": "^\\+?[0-9 ()-]+$",
        "description": "7-15 digits; common international formatting accepted, including Gambian numbers."
      },
      "password": {
        "type": "string",
        "minLength": 12,
        "maxLength": 72,
        "format": "password",
        "writeOnly": true,
        "description": "At most 72 UTF-8 bytes, not merely characters. Never returned."
      },
      "role": {
        "type": "string",
        "enum": ["DONOR"]
      }
    },
    "required": ["name", "email", "phone", "password"],
    "additionalProperties": false
  },
  "Login": {
    "type": "object",
    "properties": {
      "email": {
        "type": "string",
        "format": "email",
        "maxLength": 254,
        "example": "example@example.invalid"
      },
      "password": {
        "type": "string",
        "minLength": 1,
        "maxLength": 72,
        "format": "password",
        "writeOnly": true
      }
    },
    "required": ["email", "password"],
    "additionalProperties": false
  },
  "User": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-fA-F0-9]{24}$",
        "example": "0123456789abcdef01234567"
      },
      "name": {
        "type": "string"
      },
      "email": {
        "type": "string",
        "format": "email",
        "maxLength": 254,
        "example": "example@example.invalid"
      },
      "phone": {
        "type": "string",
        "minLength": 7,
        "maxLength": 30,
        "pattern": "^\\+?[0-9 ()-]+$",
        "description": "7-15 digits; common international formatting accepted, including Gambian numbers."
      },
      "role": {
        "type": "string",
        "enum": ["DONOR", "FACILITY_USER", "ADMIN"]
      },
      "isActive": {
        "type": "boolean"
      },
      "createdAt": {
        "type": "string",
        "format": "date-time"
      },
      "updatedAt": {
        "type": "string",
        "format": "date-time"
      }
    },
    "required": [
      "id",
      "name",
      "email",
      "phone",
      "role",
      "isActive",
      "createdAt",
      "updatedAt"
    ],
    "additionalProperties": false
  },
  "Session": {
    "type": "object",
    "properties": {
      "user": {
        "$ref": "#/components/schemas/User"
      },
      "accessToken": {
        "type": "string",
        "description": "Short-lived signed bearer token; no real token example is published."
      },
      "tokenType": {
        "type": "string",
        "enum": ["Bearer"]
      }
    },
    "required": ["user", "accessToken", "tokenType"],
    "additionalProperties": false
  },
  "FacilityCreate": {
    "type": "object",
    "properties": {
      "name": {
        "type": "string",
        "minLength": 2,
        "maxLength": 100
      },
      "facilityType": {
        "type": "string",
        "enum": ["HOSPITAL", "BLOOD_BANK", "HEALTH_CENTRE", "CLINIC", "OTHER"]
      },
      "referenceNumber": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      },
      "phone": {
        "type": "string",
        "minLength": 7,
        "maxLength": 30,
        "pattern": "^\\+?[0-9 ()-]+$",
        "description": "7-15 digits; common international formatting accepted, including Gambian numbers."
      },
      "email": {
        "type": "string",
        "format": "email",
        "maxLength": 254,
        "example": "example@example.invalid"
      },
      "address": {
        "type": "string",
        "minLength": 3,
        "maxLength": 500
      }
    },
    "required": ["name", "facilityType", "phone", "email", "address"],
    "additionalProperties": false
  },
  "FacilityTransition": {
    "type": "object",
    "properties": {
      "previousStatus": {
        "type": "string",
        "enum": ["PENDING", "APPROVED", "REJECTED", "SUSPENDED"]
      },
      "newStatus": {
        "type": "string",
        "enum": ["PENDING", "APPROVED", "REJECTED", "SUSPENDED"]
      },
      "performedBy": {
        "type": "string",
        "pattern": "^[a-fA-F0-9]{24}$",
        "example": "0123456789abcdef01234567"
      },
      "reason": {
        "type": "string"
      },
      "timestamp": {
        "type": "string",
        "format": "date-time"
      }
    },
    "required": [
      "previousStatus",
      "newStatus",
      "performedBy",
      "reason",
      "timestamp"
    ],
    "additionalProperties": false
  },
  "Facility": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-fA-F0-9]{24}$",
        "example": "0123456789abcdef01234567"
      },
      "name": {
        "type": "string"
      },
      "facilityType": {
        "type": "string",
        "enum": ["HOSPITAL", "BLOOD_BANK", "HEALTH_CENTRE", "CLINIC", "OTHER"]
      },
      "phone": {
        "type": "string",
        "minLength": 7,
        "maxLength": 30,
        "pattern": "^\\+?[0-9 ()-]+$",
        "description": "7-15 digits; common international formatting accepted, including Gambian numbers."
      },
      "email": {
        "type": "string",
        "format": "email",
        "maxLength": 254,
        "example": "example@example.invalid"
      },
      "address": {
        "type": "string"
      },
      "verificationStatus": {
        "type": "string",
        "enum": ["PENDING", "APPROVED", "REJECTED", "SUSPENDED"]
      },
      "isActive": {
        "type": "boolean"
      },
      "referenceNumber": {
        "type": "string"
      },
      "approvedAt": {
        "type": "string",
        "format": "date-time"
      },
      "approvedBy": {
        "type": "string",
        "pattern": "^[a-fA-F0-9]{24}$",
        "example": "0123456789abcdef01234567"
      },
      "rejectionReason": {
        "type": "string"
      },
      "createdBy": {
        "type": "string",
        "pattern": "^[a-fA-F0-9]{24}$",
        "example": "0123456789abcdef01234567"
      },
      "createdAt": {
        "type": "string",
        "format": "date-time"
      },
      "updatedAt": {
        "type": "string",
        "format": "date-time"
      },
      "statusHistory": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/FacilityTransition"
        }
      }
    },
    "required": [
      "id",
      "name",
      "facilityType",
      "phone",
      "email",
      "address",
      "verificationStatus",
      "isActive"
    ],
    "additionalProperties": false
  },
  "FacilityLocation": {
    "type": "object",
    "properties": {
      "facilityId": {
        "type": "string",
        "pattern": "^[a-fA-F0-9]{24}$",
        "example": "0123456789abcdef01234567"
      },
      "location": {
        "$ref": "#/components/schemas/GeoPoint"
      },
      "locationUpdatedAt": {
        "type": "string",
        "format": "date-time"
      }
    },
    "required": ["facilityId", "location", "locationUpdatedAt"],
    "additionalProperties": false
  },
  "StaffCreate": {
    "type": "object",
