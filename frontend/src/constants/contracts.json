        "nullable": true
      },
      "bloodRequest": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{24}$",
            "example": "0123456789abcdef01234567"
          },
          "patientBloodType": {
            "type": "string",
            "enum": ["A+", "A-", "B+", "B-", "AB+", "AB-", "O+", "O-"]
          },
          "unitsNeeded": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "remainingUnits": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "urgency": {
            "type": "string",
            "enum": ["CRITICAL", "URGENT", "PLANNED"]
          },
          "status": {
            "type": "string",
            "enum": [
              "OPEN",
              "PARTIALLY_FILLED",
              "FULFILLED",
              "EXPIRED",
              "CANCELLED"
            ]
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "facility": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-fA-F0-9]{24}$",
                "example": "0123456789abcdef01234567"
              },
              "name": {
                "type": "string"
              },
              "address": {
                "type": "string"
              }
            },
            "required": ["id", "name", "address"],
            "additionalProperties": false,
            "nullable": true
          },
          "actionable": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "patientBloodType",
          "unitsNeeded",
          "remainingUnits",
          "urgency",
          "status",
          "expiresAt",
          "facility",
          "actionable"
        ],
        "additionalProperties": false,
        "nullable": true
      }
    },
