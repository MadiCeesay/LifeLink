        "type": "string",
        "minLength": 2,
        "maxLength": 100
      },
      "email": {
        "type": "string",
        "format": "email",
        "maxLength": 254,
        "example": "example@example.invalid"
      },
      "phone": {
        "type": "string",
        "minLength": 7,
        "maxLength": 30,
        "pattern": "^\\+?[0-9 ()-]+$",
        "description": "7-15 digits; common international formatting accepted, including Gambian numbers."
      },
      "password": {
        "type": "string",
        "minLength": 12,
        "maxLength": 72,
        "format": "password",
