{
  "expo": {
    "name": "LifeLink",
    "slug": "lifelink",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "gm.lifelink.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "1"
    },
    "android": {
      "package": "gm.lifelink.mobile",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "versionCode": 1
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "LifeLink",
      "shortName": "LifeLink",
      "themeColor": "#A61B2B",
      "backgroundColor": "#F8F8F7"
    },
    "scheme": "lifelink",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "LifeLink uses your location, with your consent, to identify relevant blood requests. Your exact location is not shown to facilities."
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#F8F8F7"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "LifeLink uses the camera to scan donor cards at the hospital.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#A61B2B",
          "defaultChannel": "alerts"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "icon": "./assets/icon.png",
    "primaryColor": "#A61B2B",
    "owner": "madiceesays-team",
    "extra": {
      "eas": {
        "projectId": "44e40ea9-b74d-496c-a3aa-857feebff760"
      }
    }
  }
}
