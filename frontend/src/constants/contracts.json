  },
  "VerificationEvent": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-fA-F0-9]{24}$",
        "example": "0123456789abcdef01234567"
      },
      "donorId": {
        "type": "string",
        "pattern": "^[a-fA-F0-9]{24}$",
        "example": "0123456789abcdef01234567"
      },
      "facilityId": {
        "type": "string",
        "pattern": "^[a-fA-F0-9]{24}$",
        "example": "0123456789abcdef01234567",
        "nullable": true
      },
      "performedBy": {
        "type": "string",
        "pattern": "^[a-fA-F0-9]{24}$",
        "example": "0123456789abcdef01234567"
      },
      "previousStatus": {
        "type": "string",
        "enum": [
          "UNVERIFIED",
          "VERIFIED",
          "SUSPENDED",
          "REQUIRES_REVERIFICATION"
        ]
      },
      "newStatus": {
        "type": "string",
        "enum": [
          "UNVERIFIED",
          "VERIFIED",
          "SUSPENDED",
          "REQUIRES_REVERIFICATION"
        ]
      },
      "verifiedBloodType": {
        "type": "string",
        "enum": ["A+", "A-", "B+", "B-", "AB+", "AB-", "O+", "O-", null],
        "nullable": true
      },
      "reason": {
        "type": "string"
      },
      "notes": {
        "type": "string",
        "description": "Only authorized verification-history readers receive internal notes."
      },
      "sequence": {
        "type": "integer",
        "minimum": 1
      },
      "timestamp": {
        "type": "string",
        "format": "date-time"
      }
    },
    "required": [
