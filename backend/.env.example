NODE_ENV=development
PORT=5000
# Leave empty locally (binds 127.0.0.1). Production binds 0.0.0.0 automatically.
HOST=
# Set to 1 when deployed behind one proxy (Render, Railway, Fly).
TRUST_PROXY=0
# Phase 2 requires a replica set (local example) or MongoDB Atlas.
MONGODB_URI=mongodb://127.0.0.1:27017/lifelink?replicaSet=lifelink-rs
# Generate a random secret of at least 32 characters; replace this empty value.
JWT_SECRET=
JWT_EXPIRES_IN=1h
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Development freshness window; production value requires policy review (1-10080).
DONOR_LOCATION_MAX_AGE_MINUTES=60
# Internal candidate discovery stages in km: ascending, unique, >0, <=500; max 10.
MATCH_RADIUS_STAGES_KM=5,10,20,40
# Maximum future expiry at request creation, in operational hours.
BLOOD_REQUEST_MAX_LIFETIME_HOURS=72
# Operational matching pause only; not medical clearance. Review production policy.
DONATION_MATCHING_PAUSE_DAYS=56
# Per authenticated staff member, per 15 minutes, in addition to the global limit.
BROADCAST_RATE_LIMIT=20
# Public app URL, used in alert links (e.g. https://lifelink-gm.vercel.app)
APP_URL=
# Phone alerts (web push). Generate once with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Minutes before an under-answered request widens its search automatically (0 = off)
AUTO_ESCALATE_MINUTES=10
# SMS sign-in codes: none | console (dev only) | twilio
SMS_PROVIDER=none
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
